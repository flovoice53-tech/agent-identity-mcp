{
  "name": "agent-identity-mcp",
  "version": "0.1.6",
  "mcpName": "io.github.flovoice53-tech/agent-identity-mcp",
  "description": "MCP server that gives an AI agent a disposable email address and a real UK phone number so it can test a signup/verification flow end to end.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "disposable-email",
    "temp-email",
    "sms",
    "otp",
    "otp-testing",
    "test-automation",
    "qa-testing",
    "ai-agent",
    "claude",
    "claude-code",
    "cursor"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-identity-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts src/http.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sms-florin/mcpmeter": "^0.2.0",
    "sms-florin": "^0.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
